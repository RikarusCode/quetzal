{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quetzal",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": "../../dist/site", "binding": "ASSETS", "run_worker_first": ["/relay/*", "/health"]},
  "vars": {"ALLOWED_ORIGINS": "http://127.0.0.1:4173,http://localhost:4173"},
  "durable_objects": {"bindings": [{"name": "ROOMS", "class_name": "GameRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["GameRoom"]}],
  "observability": {"enabled": true, "logs": {"enabled": true, "invocation_logs": false}},
  "dev": {"ip": "127.0.0.1", "port": 8787}
}
